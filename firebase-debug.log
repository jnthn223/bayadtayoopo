[debug] [2026-07-30T14:29:50.824Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/group-expense-management-app/rulesets {"name":"projects/group-expense-management-app/rulesets/68e70a92-ba18-436c-8b8a-ee8d958a7186","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function isSelf(userId) {\n      return signedIn() && request.auth.uid == userId;\n    }\n\n    function validUserDoc() {\n      return request.resource.data.keys().hasOnly([\n          'groupIds',\n          'name',\n          'color',\n          'avatarSeed',\n          'notificationReadAt',\n          'notificationPreferences'\n        ])\n        && request.resource.data.groupIds is list\n        && (!request.resource.data.keys().hasAny(['name'])\n          || request.resource.data.name is string)\n        && (!request.resource.data.keys().hasAny(['color'])\n          || request.resource.data.color is string)\n        && (!request.resource.data.keys().hasAny(['avatarSeed'])\n          || (request.resource.data.avatarSeed is string\n            && request.resource.data.avatarSeed.size() <= 100))\n        && (!request.resource.data.keys().hasAny(['notificationReadAt'])\n          || request.resource.data.notificationReadAt is string)\n        && (!request.resource.data.keys().hasAny(['notificationPreferences'])\n          || (request.resource.data.notificationPreferences is map\n            && request.resource.data.notificationPreferences.keys().hasOnly([\n              'payments',\n              'expenses',\n              'chat',\n              'memberActivity',\n              'systemNotifications',\n              'mutedChatGroupIds'\n            ])\n            && request.resource.data.notificationPreferences.payments is bool\n            && request.resource.data.notificationPreferences.expenses is bool\n            && request.resource.data.notificationPreferences.chat is bool\n            && request.resource.data.notificationPreferences.memberActivity is bool\n            && request.resource.data.notificationPreferences.systemNotifications is bool\n            && request.resource.data.notificationPreferences.mutedChatGroupIds is list\n            && request.resource.data.notificationPreferences.mutedChatGroupIds.size() <= 100));\n    }\n\n    function validGroupDoc(data) {\n      return data.keys().hasOnly(['data', 'memberIds', 'adminUid', 'deleted', 'updatedAt'])\n        && data.data is string\n        && data.memberIds is list\n        && data.memberIds.size() > 0\n        && data.adminUid is string\n        && data.deleted is bool\n        && data.updatedAt is string;\n    }\n\n    function hasDeletedFlag(data) {\n      return data.keys().hasAny(['deleted']);\n    }\n\n    function hasAdminUid(data) {\n      return data.keys().hasAny(['adminUid']);\n    }\n\n    function isNotDeleted(data) {\n      return !hasDeletedFlag(data) || data.deleted == false;\n    }\n\n    function isGroupMember() {\n      return signedIn()\n        && resource.data.memberIds.hasAny([request.auth.uid])\n        && isNotDeleted(resource.data);\n    }\n\n    function isIncomingGroupMember() {\n      return signedIn()\n        && request.resource.data.memberIds.hasAny([request.auth.uid])\n        && request.resource.data.deleted == false;\n    }\n\n    function isGroupAdmin() {\n      return isGroupMember() && resource.data.adminUid == request.auth.uid;\n    }\n\n    function adminUnchanged() {\n      return request.resource.data.adminUid == resource.data.adminUid;\n    }\n\n    function adminUnchangedOrBackfilled() {\n      return adminUnchanged()\n        || (!hasAdminUid(resource.data)\n          && request.resource.data.memberIds.hasAny([request.resource.data.adminUid]));\n    }\n\n    function memberUpdateKeepsSecurityFields() {\n      return isGroupMember()\n        && isIncomingGroupMember()\n        && adminUnchangedOrBackfilled()\n        && (!hasDeletedFlag(resource.data)\n          || request.resource.data.deleted == resource.data.deleted);\n    }\n\n    function adminUpdate() {\n      return isGroupAdmin()\n        && request.resource.data.memberIds.hasAny([request.auth.uid]);\n    }\n\n    function joinByInviteLink() {\n      return signedIn()\n        && isNotDeleted(resource.data)\n        && !resource.data.memberIds.hasAny([request.auth.uid])\n        && request.resource.data.memberIds.hasAll(resource.data.memberIds)\n        && request.resource.data.memberIds.hasAny([request.auth.uid])\n        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1\n        && adminUnchangedOrBackfilled()\n        && (!hasDeletedFlag(resource.data)\n          || request.resource.data.deleted == resource.data.deleted);\n    }\n\n    match /users/{userId} {\n      allow read: if isSelf(userId);\n      allow create, update: if isSelf(userId) && validUserDoc();\n      allow delete: if false;\n\n    }\n\n    match /groups/{groupId} {\n      allow create: if signedIn()\n        && validGroupDoc(request.resource.data)\n        && request.resource.data.memberIds.hasAny([request.auth.uid])\n        && request.resource.data.adminUid == request.auth.uid\n        && request.resource.data.deleted == false;\n\n      allow get: if isGroupMember() || (signedIn() && isNotDeleted(resource.data));\n      allow list: if isGroupMember();\n\n      allow update: if validGroupDoc(request.resource.data)\n        && (memberUpdateKeepsSecurityFields() || adminUpdate() || joinByInviteLink());\n\n      allow delete: if false;\n    }\n\n    match /groups/{groupId}/paymentImages/{imageId} {\n      function parentGroup() {\n        return get(/databases/$(database)/documents/groups/$(groupId));\n      }\n\n      function isPaymentImageGroupMember() {\n        return signedIn()\n          && parentGroup().data.memberIds.hasAny([request.auth.uid])\n          && isNotDeleted(parentGroup().data);\n      }\n\n      allow read: if isPaymentImageGroupMember();\n      allow create: if isPaymentImageGroupMember()\n        && request.resource.data.keys().hasOnly(['dataUrl', 'ownerUid', 'kind', 'createdAt'])\n        && request.resource.data.ownerUid == request.auth.uid\n        && request.resource.data.kind in ['qr-code', 'payment-proof', 'expense-receipt']\n        && request.resource.data.dataUrl is string\n        && request.resource.data.dataUrl.size() < 700000\n        && request.resource.data.createdAt is string;\n      allow update: if false;\n      allow delete: if isPaymentImageGroupMember()\n        && resource.data.ownerUid == request.auth.uid;\n    }\n\n    // Legacy path from the early local-per-user Firestore model.\n    match /users/{userId}/groups/{groupId} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-07-30T14:29:51.961919Z","metadata":{"services":["cloud.firestore"]}}
